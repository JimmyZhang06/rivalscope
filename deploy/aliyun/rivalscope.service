[Unit]
Description=RivalScope API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rivalscope
Group=rivalscope
WorkingDirectory=/opt/rivalscope/backend
EnvironmentFile=/etc/rivalscope/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
# One worker: the application starts an in-process scheduler and background jobs.
ExecStart=/opt/rivalscope/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=rivalscope
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rivalscope

[Install]
WantedBy=multi-user.target
