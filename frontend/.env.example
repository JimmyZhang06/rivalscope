# Build-time public configuration. Never put credentials in VITE_* values.
# Empty: same-origin /api through Vite (development) or Nginx (production).
# GitHub Pages: set the HTTPS origin of the Aliyun API, without /api or a path.
VITE_API_ORIGIN=

# Development proxy only; this does not configure a deployed frontend.
VITE_API_TARGET=http://127.0.0.1:8000
