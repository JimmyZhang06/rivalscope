# LLM 配置（OpenAI 兼容接口，支持 OpenAI / DeepSeek / 通义千问 / Kimi 等）
# 示例（DeepSeek）: https://api.deepseek.com/v1
# 示例（通义千问）: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-chat

# Tavily 联网检索 API Key（https://tavily.com 免费注册，1000 次/月）
TAVILY_API_KEY=your-tavily-api-key

# 数据库连接（默认 SQLite，无需修改）
DATABASE_URL=sqlite:///./research.db

# JWT 认证
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7

# SMTP 邮件推送（可选：不配置则报告邮件走演示模式，仅落库 email_logs）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 前端基础 URL：邮件中「查看完整报告」链接前缀（生产环境改为实际域名，如 https://your-domain.com）
FRONTEND_BASE=http://localhost:5173
