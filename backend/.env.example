# LLM 配置（OpenAI 兼容接口，支持 OpenAI / DeepSeek / 通义千问 / Kimi 等）
APP_ENV=development

# 可选：首次启动时创建管理员。仅在两个值都填写时生效；生产环境请使用强随机密码。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 本地演示支付；生产环境即使设为 true 也会由后端强制禁用
ENABLE_SIMULATED_BILLING=true

# 示例（DeepSeek）: https://api.deepseek.com/v1
# 示例（通义千问）: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180

# Tavily 联网检索 API Key（https://tavily.com 免费注册，1000 次/月）
TAVILY_API_KEY=your-tavily-api-key

# 数据库连接（默认 SQLite，无需修改）
DATABASE_URL=sqlite:///./research.db

# JWT 认证
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=1

# Fernet 加密主密钥（生成方式见 README；使用敏感字段功能时必须配置）
MASTER_KEY=

# SMTP 邮件推送（可选：不配置则报告邮件走演示模式，仅落库 email_logs）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 前端基础 URL：邮件中「查看完整报告」链接前缀（生产环境改为实际域名，如 https://your-domain.com）
FRONTEND_BASE=http://localhost:5173

# CORS 允许来源，多个值用逗号分隔
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
